# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The training page's Postgres, as seen from this machine. Through an SSH tunnel
# (ssh -N -L 5433:localhost:5432 you@the-vm):
TRAINING_DATABASE_URL=postgresql://asigner:PASSWORD@127.0.0.1:5433/asigner
# Or straight to the VM when it has POSTGRES_BIND=0.0.0.0:
# TRAINING_DATABASE_URL=postgresql://asigner:PASSWORD@192.168.1.50:5432/asigner

# 1: stop if no GPU is visible, rather than quietly training on the CPU.
REQUIRE_GPU=1

# PyTorch CUDA build. cu128 runs on a GTX 1660 Super with NVIDIA driver 570 or newer.
TORCH_CUDA=cu128
