# SITE_ADDRESS is a domain name (Caddy gets a Let's Encrypt certificate, which
# needs ports 80 and 443 reachable from the internet) or the VM's IP address
# (Caddy signs its own certificate, and browsers warn once until it is trusted).

(routes) {
	encode gzip

	# Contributors only need the training page.
	redir / /train

	handle /api/* {
		reverse_proxy server:8000
	}
	handle {
		reverse_proxy web:3000
	}
}

{$SITE_ADDRESS} {
	import routes
}

# For the Cloudflare tunnel only. Cloudflare serves HTTPS with a real certificate
# and forwards plain HTTP to this port, which is reachable only inside Docker's
# network (it is not published in docker-compose.yml).
http://:8080 {
	import routes
}
