# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# The VM's domain name or IP address, without https://. For example 192.168.1.50
SITE_ADDRESS=

# Letters and digits only (it goes into a database URL). For example: openssl rand -hex 24
POSTGRES_PASSWORD=
# Where Postgres listens: 127.0.0.1 (SSH tunnel only) or 0.0.0.0 (the whole network).
POSTGRES_BIND=127.0.0.1

# Signs session cookies. For example: openssl rand -hex 32
SESSION_SECRET=

# The code contributors type on the training page. Share it only with them.
TRAINING_ACCESS_CODE=
