# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://asigner:asigner@localhost:5432/asigner
SESSION_SECRET=change-me-to-a-long-random-string
# Create an OAuth client (type: Web application) in Google Cloud Console.
# Authorised redirect URI: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
OLLAMA_URL=http://localhost:11434
SENTENCE_MODEL=
# Local development only: sign in without Google at /api/auth/dev-login.
DEV_LOGIN=false
# The code contributors type on /train. May stay empty only when FRONTEND_URL is localhost.
TRAINING_ACCESS_CODE=
